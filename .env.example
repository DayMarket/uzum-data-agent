# Доступы для uzum-data-agent.
#
#   cp .env.example .env   →   заполни   →   ./setup.sh
#
# Мастер найдёт файл сам, проверит каждый доступ живым запросом и покажет
# результат. Незаполненное спросит; `./setup.sh --non-interactive` вместо
# вопроса скажет, чего не хватает.
#
# Значения без кавычек. Апостроф внутри пароля — оберни всё значение в
# двойные: TOKEN="it's-a-token". Пробел, `$` и обратные кавычки экранировать
# не нужно.
#
# Здесь пароли открытым текстом. В git файл не попадает, после установки
# мастер предложит его удалить.
#
# Где взять каждый доступ — connectors/ACCESS.md.

# ── ClickHouse WMS (склады) ── обязательно ─────────────────────────────
# Логин — корп-почта через дефис. Пароль — заявка в JSM, «Доступ к DWH».
CH_WMS_HOST=wms-clickhouse.prod.um.internal
CH_WMS_PORT=8123
CH_WMS_USER=
CH_WMS_PASSWORD=

# ── Jira / Confluence ── обязательно ───────────────────────────────────
# Профиль → Personal Access Tokens → Create token.
# Токена ДВА, по одному на продукт: PAT в Atlassian Server/DC действует
# только там, где создан (токен Jira Confluence не принимает — 401).
# JIRA_TOKEN — в jira.uzum.com, CONFLUENCE_TOKEN — в confluence.uzum.com.
# Без CONFLUENCE_TOKEN Jira работает, недоступен только Confluence.
JIRA_TOKEN=
CONFLUENCE_TOKEN=

# ── ClickHouse DWH (продажи, финансы, маркетинг) ───────────────────────
# Учётка отдельная от складской: заявка в JSM подаётся своя.
CH_DWH_HOST=dwh-clickhouse.prod.um.internal
CH_DWH_PORT=8123
CH_DWH_USER=
CH_DWH_PASSWORD=

# ── Superset ───────────────────────────────────────────────────────────
# Корп-учётка Keycloak, та же, что открывает Superset в браузере. Сам
# браузер не открывается: форму входа отправляет коннектор.
SUPERSET_URL=https://bi.uzum.uz
SUPERSET_USERNAME=
SUPERSET_PASSWORD=

# ── Trino ──────────────────────────────────────────────────────────────
# Кредов не нужно, вход по SSO. Email — только для атрибуции запросов.
TRINO_USER=

# ── Grafana ────────────────────────────────────────────────────────────
# Адрес один на всю компанию, спрашивать нечего. Нужен сервисный токен —
# заявка платформе.
GRAFANA_URL=https://ops-grafana.prod.cluster.daymarket.uz
GRAFANA_TOKEN=

# ── OpenMetadata ───────────────────────────────────────────────────────
# Профиль → Access Token.
OMD_URL=
OMD_TOKEN=

# ── GrowthBook ─────────────────────────────────────────────────────────
# Settings → API Keys → read-only ключ.
GROWTHBOOK_TOKEN=

# ── Google Sheets ──────────────────────────────────────────────────────
# Файл сервисного аккаунта — у Насти. Папку с таблицами расшарь на его
# почту, мастер покажет её при проверке. ID папки — из URL:
# drive.google.com/drive/folders/ЭТОТ_ID
GOOGLE_SA_FILE=
GOOGLE_SHEETS_FOLDER_ID=
