# Шаблон файла доступов для uzum-data-agent.
#
# Как пользоваться:
#   1. cp .env.example .env
#   2. Впиши значения ниже, сверяясь с подсказками "где взять" и с
#      connectors/ACCESS.md (там то же самое подробнее).
#   3. Запусти ./setup.sh — он найдёт .env сам, ничего не спросит про то, что
#      уже заполнено, но всё равно живой проверкой покажет, что каждый
#      заполненный доступ реально работает (те же "вижу 47 баз",
#      "вижу тебя как Denis Platon", что и при ручном вводе).
#   4. Пустые строки и целые блоки можно оставить как есть — то, что не
#      заполнено, мастер спросит как обычно. ./setup.sh --non-interactive
#      вместо вопроса скажет, чего не хватает, и завершится с ошибкой.
#
# Значения без кавычек, как в примерах ниже. Если внутри пароля есть
# апостроф — оберни всё значение в двойные кавычки: TOKEN="it's-a-token".
# Про пробел, `$` и обратные кавычки можно не думать — не экранируются: файл
# разбирает lib/envfile.py, а не шелл, буквально всё после "=" до конца
# строки берётся как есть (кроме апострофа/кавычек, см. выше).
#
# .env — тот же класс данных, что и ~/.config/uzum-ai/secrets.env: пароли и
# токены в открытом виде. Файл в git не попадает (.gitignore), но держи его
# только у себя и после первой успешной установки смело удаляй — мастер сам
# предложит это в конце.

# ── ClickHouse: складской кластер (WMS) ───────────────────────────────
# Основной для операционной аналитики: склады, сборка, приёмка. Здесь же
# живёт телеметрия (sandbox.ai_usage_*) — блок ниже по умолчанию берёт эти
# же логин/пароль. Хост: wms-clickhouse.prod.um.internal, порт обычно 8123.
# Логин — корп-почта через дефис. Пароль — заявка в JSM, тип «Доступ к DWH».
# Можно пропустить, если работаешь только с общим DWH ниже — тогда просто
# не поднимется коннектор clickhouse-wms, остальное не пострадает.
CH_WMS_HOST=
CH_WMS_PORT=
CH_WMS_USER=
CH_WMS_PASSWORD=

# ── ClickHouse: общий кластер (DWH) ────────────────────────────────────
# Продажи, финансы, маркетинг. Хост: dwh-clickhouse.prod.um.internal, порт
# обычно 8123. Учётка — отдельная от складского кластера выше, это два
# независимых доступа, а не один с двумя адресами: тот же формат заявки в
# JSM, но подать нужно отдельно. Можно пропустить, если работаешь только со
# складом — тогда просто не поднимется коннектор clickhouse-dwh.
CH_DWH_HOST=
CH_DWH_PORT=
CH_DWH_USER=
CH_DWH_PASSWORD=

# ── Телеметрия ─────────────────────────────────────────────────────────
# Можно пропустить: доступ не отдельный, а те же логин/пароль складского
# ClickHouse (CH_WMS_* выше). Заполняй, только если телеметрия должна идти
# на другой хост/пользователя, чем блок CH_WMS_* — таблицы sandbox.ai_usage_*
# есть только на складском кластере (wms-clickhouse.prod.um.internal), общий
# DWH для телеметрии не годится.
TELEMETRY_CH_HOST=
TELEMETRY_CH_PORT=
TELEMETRY_CH_USER=
TELEMETRY_CH_PASSWORD=

# ── Jira / Confluence ──────────────────────────────────────────────────
# Обязателен. Где взять: Профиль → Personal Access Tokens → Create token.
JIRA_TOKEN=

# ── Superset ───────────────────────────────────────────────────────────
# Кредов не нужно — вход через Keycloak SSO в браузере при первом обращении.
# URL можно оставить пустым: подставится дефолт https://bi.uzum.uz.
SUPERSET_URL=

# ── Trino ──────────────────────────────────────────────────────────────
# Можно пропустить. Кредов не нужно — OAuth2 SSO в браузере при первом
# запросе. TRINO_USER — не секрет, просто твой email для атрибуции запросов;
# без него коннектор всё равно поднимется, но первый запрос упадёт с понятной
# ошибкой, пока переменную не заполнить.
TRINO_USER=

# ── Grafana ────────────────────────────────────────────────────────────
# Можно пропустить (коннектор не поднимется без него, остальные не
# пострадают). Где взять: сервисный токен у платформы — URL приходит вместе
# с токеном.
GRAFANA_URL=
GRAFANA_TOKEN=

# ── OpenMetadata ───────────────────────────────────────────────────────
# Можно пропустить. Где взять: Профиль → Access Token. URL — спроси в
# платформе, если нет под рукой.
OMD_URL=
OMD_TOKEN=

# ── GrowthBook ─────────────────────────────────────────────────────────
# Можно пропустить. Где взять: Settings → API Keys → read-only ключ.
GROWTHBOOK_TOKEN=

# ── Google Sheets ──────────────────────────────────────────────────────
# Можно пропустить. Файл сервисного аккаунта — у Насти; путь ниже локальный
# (на диске), не секрет сам по себе — GOOGLE_SA_FILE указывает, ГДЕ лежит
# файл с приватным ключом. Не забудь расшарить папку с таблицами на email
# сервисного аккаунта (мастер покажет его при живой проверке).
# ID папки — из URL: drive.google.com/drive/folders/ЭТОТ_ID
GOOGLE_SA_FILE=
GOOGLE_SHEETS_FOLDER_ID=
