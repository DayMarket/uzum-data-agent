{
  "mcpServers": {
    "atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "${JIRA_URL:-https://jira.uzum.com}",
        "JIRA_PERSONAL_TOKEN": "${JIRA_TOKEN}",
        "CONFLUENCE_URL": "${CONFLUENCE_URL:-https://confluence.uzum.com}",
        "CONFLUENCE_PERSONAL_TOKEN": "${JIRA_TOKEN}"
      }
    },
    "clickhouse-wms": {
      "command": "uvx",
      "args": [
        "--with",
        "pyarrow",
        "mcp-clickhouse"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "CLICKHOUSE_HOST": "${CH_WMS_HOST}",
        "CLICKHOUSE_PORT": "${CH_WMS_PORT:-8123}",
        "CLICKHOUSE_USER": "${CH_WMS_USER}",
        "CLICKHOUSE_PASSWORD": "${CH_WMS_PASSWORD}",
        "CLICKHOUSE_SECURE": "${CH_WMS_SECURE:-false}",
        "CLICKHOUSE_VERIFY": "false",
        "CHDB_ENABLED": "false"
      }
    },
    "clickhouse-dwh": {
      "command": "uvx",
      "args": [
        "--with",
        "pyarrow",
        "mcp-clickhouse"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "CLICKHOUSE_HOST": "${CH_DWH_HOST}",
        "CLICKHOUSE_PORT": "${CH_DWH_PORT:-8123}",
        "CLICKHOUSE_USER": "${CH_DWH_USER}",
        "CLICKHOUSE_PASSWORD": "${CH_DWH_PASSWORD}",
        "CLICKHOUSE_SECURE": "${CH_DWH_SECURE:-false}",
        "CLICKHOUSE_VERIFY": "false",
        "CHDB_ENABLED": "false"
      }
    },
    "trino": {
      "command": "uv",
      "args": [
        "run",
        "${CLAUDE_PROJECT_DIR:-.}/connectors/trino_proxy.py"
      ],
      "env": {
        "TRINO_HOST": "${TRINO_HOST:-trino.prod-data.internal.daymarket.uz}",
        "TRINO_CATALOG": "${TRINO_CATALOG:-dwh-iceberg}"
      }
    },
    "superset": {
      "command": "uv",
      "args": [
        "run",
        "${CLAUDE_PROJECT_DIR:-.}/connectors/superset_mcp.py"
      ],
      "env": {
        "SUPERSET_URL": "${SUPERSET_URL}",
        "SUPERSET_USERNAME": "${SUPERSET_USERNAME}",
        "SUPERSET_PASSWORD": "${SUPERSET_PASSWORD}"
      }
    },
    "grafana": {
      "command": "uvx",
      "args": [
        "mcp-grafana"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_TOKEN}"
      }
    },
    "openmetadata": {
      "command": "uvx",
      "args": [
        "--with",
        "fastmcp<2.4",
        "--with",
        "pydantic<2.9",
        "--from",
        "mcp-openmetadata",
        "python",
        "-m",
        "mcp_openmetadata.server"
      ],
      "env": {
        "OPENMETADATA_URI": "${OMD_URL}",
        "OPENMETADATA_JWT_TOKEN": "${OMD_TOKEN}"
      }
    },
    "growthbook": {
      "command": "npx",
      "args": [
        "-y",
        "@growthbook/mcp"
      ],
      "env": {
        "GB_API_KEY": "${GROWTHBOOK_TOKEN}"
      }
    },
    "sheets": {
      "command": "uv",
      "args": [
        "run",
        "${CLAUDE_PROJECT_DIR:-.}/connectors/sheets_mcp.py"
      ],
      "env": {
        "GOOGLE_SERVICE_ACCOUNT_FILE": "${GOOGLE_SA_FILE}",
        "GOOGLE_SHEETS_FOLDER_ID": "${GOOGLE_SHEETS_FOLDER_ID}"
      }
    }
  }
}
