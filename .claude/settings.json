{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "Write(work/**)",
      "Edit(work/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(du:*)",
      "mcp__clickhouse-wms__list_databases",
      "mcp__clickhouse-wms__list_tables",
      "mcp__clickhouse-dwh__list_databases",
      "mcp__clickhouse-dwh__list_tables",
      "mcp__trino__list_catalogs",
      "mcp__trino__list_schemas",
      "mcp__trino__list_tables",
      "mcp__trino__describe_table",
      "mcp__superset__list_dashboards",
      "mcp__superset__list_dashboard_charts",
      "mcp__superset__list_charts",
      "mcp__superset__list_datasets",
      "mcp__superset__get_dashboard",
      "mcp__superset__get_dashboard_layout_summary",
      "mcp__superset__get_dashboard_screenshot",
      "mcp__superset__get_chart_data",
      "mcp__superset__get_chart_params_summary",
      "mcp__superset__get_chart_screenshot",
      "mcp__superset__get_dataset",
      "mcp__superset__get_dataset_summary",
      "mcp__superset__refresh_token",
      "mcp__atlassian__jira_search",
      "mcp__atlassian__jira_get_issue",
      "mcp__atlassian__jira_get_project_issues",
      "mcp__atlassian__jira_search_fields",
      "mcp__atlassian__jira_batch_get_changelogs",
      "mcp__atlassian__jira_get_worklog",
      "mcp__atlassian__jira_get_user_profile",
      "mcp__atlassian__jira_get_agile_boards",
      "mcp__atlassian__jira_get_board_issues",
      "mcp__atlassian__jira_get_sprints_from_board",
      "mcp__atlassian__jira_get_sprint_issues",
      "mcp__atlassian__confluence_search",
      "mcp__atlassian__confluence_get_page",
      "mcp__atlassian__confluence_get_page_children",
      "mcp__atlassian__confluence_get_comments",
      "mcp__atlassian__confluence_get_labels",
      "mcp__grafana__search_dashboards",
      "mcp__grafana__get_dashboard_by_uid",
      "mcp__grafana__get_dashboard_summary",
      "mcp__grafana__get_dashboard_panel_queries",
      "mcp__grafana__get_panel_image",
      "mcp__grafana__list_datasources",
      "mcp__grafana__get_datasource",
      "mcp__grafana__query_prometheus",
      "mcp__grafana__list_prometheus_metric_names",
      "mcp__grafana__list_prometheus_label_names",
      "mcp__grafana__list_prometheus_label_values",
      "mcp__grafana__query_loki_logs",
      "mcp__grafana__query_loki_stats",
      "mcp__grafana__list_loki_label_names",
      "mcp__grafana__list_loki_label_values",
      "mcp__openmetadata__search_entities_with_query",
      "mcp__openmetadata__get_list_of_tables",
      "mcp__openmetadata__get_table_by_fqn",
      "mcp__openmetadata__get_table_columns_by_fqn",
      "mcp__openmetadata__get_table_owners_by_fqn",
      "mcp__openmetadata__get_sample_data",
      "mcp__growthbook__growthbook_list_skills",
      "mcp__growthbook__growthbook_read_skill"
    ],
    "deny": [
      "Read(~/.config/uzum-ai/**)",
      "Read(.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/on_session_start.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/log_session.py",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/log_session.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/log_event.py",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
