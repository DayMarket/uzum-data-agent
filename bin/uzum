#!/usr/bin/env bash
# Запуск сессии: секреты в окружение, выбор движка (Claude Code или Codex),
# переход в корень репозитория, запуск выбранного движка.
#
# setup.sh кладёт символическую ссылку на этот файл в ~/.local/bin/uzum,
# поэтому просто `dirname "${BASH_SOURCE[0]}"` даёт ~/.local/bin, а не
# репозиторий. `readlink -f` для разворачивания ссылки не используем: это
# GNU-расширение, на macOS системный /usr/bin/readlink (BSD) флага -f не
# понимает и падает — а ноутбук аналитика на macOS это как раз основной
# случай. Разворачиваем ссылку вручную, без внешних зависимостей.
set -uo pipefail

resolve_script_path() {
  local target="$1" dir
  while [ -h "$target" ]; do
    dir="$(cd -P "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    case "$target" in
      /*) ;;
      *) target="$dir/$target" ;;
    esac
  done
  dir="$(cd -P "$(dirname "$target")" && pwd)"
  printf "%s/%s" "$dir" "$(basename "$target")"
}

SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

SECRETS="$HOME/.config/uzum-ai/secrets.env"
# Запомненный выбор движка (только когда оба настроены — см. ниже). Тот же
# каталог, что уже использует UZUM_STATE_DIR в .claude/hooks/log_session.py
# для состояния между сессиями — не секрет, обычный маркер-файл.
STATE_DIR="${UZUM_STATE_DIR:-$HOME/.local/state/uzum-ai}"
ENGINE_CHOICE_FILE="$STATE_DIR/engine"
# Профиль, которым Codex подключает наш конфиг — см. lib/setup_helpers.py
# (CODEX_PROFILE_NAME) и setup.sh (CODEX_PROFILE_NAME). Держи в синхроне.
CODEX_PROFILE_NAME="uzum"

if [ -f "$SECRETS" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$SECRETS"
  set +a
else
  echo "Секреты не найдены. Запусти ./setup.sh в папке репозитория: $REPO_DIR"
  exit 1
fi

export UZUM_USER="${CH_USER:-$USER}"

# ── разбор --codex/--claude, остальное отдаём движку как есть ───────────
# Массив ARGS, а не переприсваивание "$@": аргументы движка (пути, промпты)
# могут содержать пробелы, IFS-разбиение их бы поломало.
REQUESTED_ENGINE=""
ARGS=()
for a in "$@"; do
  case "$a" in
    --codex)  REQUESTED_ENGINE="codex" ;;
    --claude) REQUESTED_ENGINE="claude" ;;
    *) ARGS+=("$a") ;;
  esac
done

# Какие движки реально стоят на этой машине — двумя флагами, не массивом:
# на пустом массиве под `set -u` в bash 3.2 (дефолт на macOS) разворачивание
# "${ARR[@]}" роняет скрипт с "unbound variable" (см. тот же приём и
# комментарий в setup.sh, переменная ENABLED).
CLAUDE_FOUND=0
CODEX_FOUND=0
command -v claude >/dev/null 2>&1 && CLAUDE_FOUND=1
command -v codex  >/dev/null 2>&1 && CODEX_FOUND=1

REMEMBERED_ENGINE=""
if [ -f "$ENGINE_CHOICE_FILE" ]; then
  REMEMBERED_ENGINE="$(cat "$ENGINE_CHOICE_FILE" 2>/dev/null || true)"
fi

# Приоритет выбора движка и решение "запоминать ли выбор" — ОДНА реализация
# (lib/setup_helpers.py::select_engine/should_remember_engine_choice,
# покрыта unit-тестами), а не переигранная копия той же развилки в bash.
# Находка ревью раунда 1 (задача Codex-6): раньше bin/uzum содержал свою
# копию этой логики бок о бок с комментарием "запоминаем только когда
# явного флага не было" — а код на самом деле сохранял выбор при ЛЮБОМ
# запуске с обоими движками, включая явный флаг; комментарий и код
# разошлись, и тесты этого не поймали, потому что проверяли не тот файл
# (python-хелпер, не bash). Здесь такой копии больше нет — bash только
# собирает вход и разбирает результат.
#
# НАХОДКА РЕВЬЮ РАУНДА 2 (Critical): сам перенос решения в отдельный
# python-процесс завёл НОВУЮ зависимость от внешнего процесса ровно в
# развилке выбора движка — а вызов ниже не проверялся ни на код возврата,
# ни на то, что REASON/ENGINE вообще что-то осмысленное. Если помощник не
# отработал (python3 отсутствует в PATH, lib/setup_helpers.py сломан,
# исключение при импорте — что угодно), SELECT_OUT пуст, ENGINE/REASON
# пустые, ни одна ветка `case` не совпадала — и скрипт безусловно проваливался
# в `exec claude` (см. блок дальше, там раньше стоял `if/else`, а не `case`,
# у else не было и не могло быть "неизвестного значения"). Воспроизведено
# ревьюером дважды, в т.ч. реалистичным сценарием "python3 отсутствует в
# PATH при обоих установленных движках": человек попросил Codex — тихо
# получил Claude Code с кодом успеха. Тот же класс дефекта, что весь этот
# проект ловит третий раз подряд — "выглядит как рабочая сессия, а на самом
# деле нет". Три независимых барьера ниже, каждый закрывает свой канал этой
# тихой деградации:
#   1. python3 проверяется явно, до первой попытки его вызвать — понятное
#      сообщение про сам факт зависимости, а не "команда не найдена" вслепую.
#   2. Код возврата python3 -c проверяется — сбой (исключение, синтаксическая
#      ошибка и т.п.) даёт честную ошибку с текстом самого сбоя, не пустые
#      переменные.
#   3. И REASON (после блока `case` ниже), и — САМОЕ ВАЖНОЕ — сам ENGINE перед
#      запуском (`case "$ENGINE" in codex|claude|*)`, не `if = codex else`)
#      проверяются на конкретное ожидаемое значение: неизвестное значение —
#      ошибка, а не тихий проход в ветку "иначе значит Claude Code".
if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 не найден в PATH — без него uzum не может выбрать движок (использует ту же проверенную логику, что и setup.sh, lib/setup_helpers.py). Поставь: xcode-select --install (или brew install python3) и запусти uzum ещё раз." >&2
  exit 1
fi

SELECT_STATUS=0
SELECT_OUT="$(
  UZUM_REQUESTED="$REQUESTED_ENGINE" UZUM_REMEMBERED="$REMEMBERED_ENGINE" \
  UZUM_CLAUDE_FOUND="$CLAUDE_FOUND" UZUM_CODEX_FOUND="$CODEX_FOUND" \
  python3 -c "
import os, sys
sys.path.insert(0, '$REPO_DIR/lib')
import setup_helpers
available = []
if os.environ.get('UZUM_CLAUDE_FOUND') == '1':
    available.append('claude')
if os.environ.get('UZUM_CODEX_FOUND') == '1':
    available.append('codex')
requested = os.environ.get('UZUM_REQUESTED') or None
remembered = os.environ.get('UZUM_REMEMBERED') or None
engine, reason = setup_helpers.select_engine(available, requested, remembered)
print(engine or '')
print(reason)
print('1' if setup_helpers.should_remember_engine_choice(reason) else '')
" 2>&1
)" || SELECT_STATUS=$?

if [ "$SELECT_STATUS" -ne 0 ]; then
  echo "Не удалось определить движок — вспомогательная проверка (python3) завершилась с ошибкой (код $SELECT_STATUS), это не должно происходить. Вывод:" >&2
  printf '%s\n' "$SELECT_OUT" >&2
  echo "Напиши Насте, приложив текст выше." >&2
  exit 1
fi

ENGINE="$(printf '%s\n' "$SELECT_OUT" | sed -n '1p')"
REASON="$(printf '%s\n' "$SELECT_OUT" | sed -n '2p')"
SHOULD_REMEMBER="$(printf '%s\n' "$SELECT_OUT" | sed -n '3p')"

case "$REASON" in
  none_available)
    echo "Не найден ни Claude Code, ни Codex. Запусти ./setup.sh — он подскажет, что поставить."
    exit 1
    ;;
  engine_not_available:*)
    echo "Запрошен --${REASON#engine_not_available:}, но его не видно в PATH на этой машине."
    exit 1
    ;;
  ambiguous)
    # Оба движка настроены, и ничего не решено ни аргументом, ни прошлым
    # запуском — не решаем молча за человека.
    echo "Установлены оба движка: Claude Code и Codex."
    read -rp "Какой запускать в этот раз? [claude/codex]: " ENGINE
    case "$ENGINE" in
      claude|codex) ;;
      *)
        echo "Не понял ответ. Запусти снова с явным выбором: uzum --claude или uzum --codex"
        exit 1
        ;;
    esac
    ;;
  requested|remembered|only_configured)
    ;;
  *)
    # Не должно происходить: select_engine() возвращает только конечный
    # набор причин (см. lib/setup_helpers.py). Если сюда попали — вывод
    # помощника чем-то повреждён/устарел (например, версия lib/setup_
    # helpers.py разошлась с этой копией bin/uzum). Честная ошибка, не
    # угадывание, что имелось в виду.
    echo "Не удалось определить движок — неожиданный ответ внутренней проверки («$REASON»). Не должно происходить, напиши Насте." >&2
    exit 1
    ;;
esac

# Запоминаем ТОЛЬКО когда should_remember_engine_choice(reason) сказал да —
# явный флаг --codex/--claude одноразовый и не должен молча менять дефолт
# для всех следующих запусков без флага. Решение целиком в python
# (SHOULD_REMEMBER выше, до интерактивного вопроса), bash здесь ничего не
# решает заново, только исполняет.
if [ -n "$SHOULD_REMEMBER" ]; then
  mkdir -p "$STATE_DIR"
  printf "%s\n" "$ENGINE" >"$ENGINE_CHOICE_FILE"
fi

# Относительные пути коннекторов (MCP-серверы обоих движков) резолвятся от
# рабочего каталога процесса движка, не от расположения его конфига
# (docs/codex-facts.md, раздел 8) — без cd сюда ни один локальный коннектор
# (trino/superset/sheets/clickhouse-обёртка) не найдётся, если запустить
# `uzum` не из корня репозитория.
#
# Хуков Codex это больше не касается: в $CODEX_HOME/hooks.json они прописаны
# абсолютными путями (lib/setup_helpers.py::codex_hook_definitions). Но cd
# нужен им с другой стороны — рабочий каталог и есть признак «сессия наша»
# (lib/hook_scope.py): запуск движка не из корня репозитория оставил бы
# сессию без телеметрии.
cd "$REPO_DIR" || exit 1

# `case`, не `if = codex else` — находка ревью раунда 2: `else` не может
# различить "точно claude" от "что угодно другое, включая пусто/мусор",
# то есть ЛЮБОЙ сбой выше по скрипту, который дотёк до этой строки, тихо
# запускал бы Claude Code. Здесь — последний, самый важный из трёх
# барьеров (см. докстринг у блока выбора движка выше): даже если что-то
# совсем неожиданное просочилось мимо всех проверок REASON, дальше пойдёт
# только ровно "codex" или ровно "claude" — и ничего третьего.
case "$ENGINE" in
  codex)
    # Переименование source→target и дефолты — мостиком, перед самым
    # запуском. У Codex нет ${VAR}-подстановки в config.toml: там только
    # `env_vars = ["ИМЯ", ...]`, то есть «переслать переменную под тем же
    # именем» (docs/codex-facts.md, раздел 4). А аналитик держит в
    # secrets.env наши имена (JIRA_TOKEN), тогда как процессы коннекторов
    # ждут свои (JIRA_PERSONAL_TOKEN). Значит выставить целевые имена
    # обязано то, что запускает codex, — иначе шесть коннекторов из девяти
    # стартуют без адреса и без токена и молча не отдают ни одного
    # инструмента (найдено на живой приёмке).
    #
    # Соответствие берётся из connectors/registry.py и больше ниоткуда —
    # второго списка имён в этом файле нет и быть не должно. Значения не
    # проходят через шелл (никаких eval/export "$line"): их читает и
    # передаёт через envp сам мостик, поэтому в `ps` они не видны, а
    # пароль с пробелом, `$`, кавычкой или переводом строки доезжает
    # дословно. Claude Code этого пути не касается — у него подстановка
    # своя и работает, ветка claude ниже не менялась.
    BRIDGE="$REPO_DIR/connectors/codex_env_bridge.py"
    if [ ! -f "$BRIDGE" ]; then
      echo "Не найден $BRIDGE — без него коннекторы Codex останутся без переменных окружения и молча не поднимутся. Похоже, клон репозитория неполный: обнови его (git pull) или переустанови." >&2
      exit 1
    fi
    if [ "${#ARGS[@]}" -gt 0 ]; then
      exec python3 "$BRIDGE" -- codex -p "$CODEX_PROFILE_NAME" "${ARGS[@]}"
    else
      exec python3 "$BRIDGE" -- codex -p "$CODEX_PROFILE_NAME"
    fi
    ;;
  claude)
    if [ "${#ARGS[@]}" -gt 0 ]; then
      exec claude "${ARGS[@]}"
    else
      exec claude
    fi
    ;;
  *)
    echo "Не удалось определить движок для запуска (пустое или неожиданное значение «$ENGINE»). Не должно происходить, напиши Насте." >&2
    exit 1
    ;;
esac
