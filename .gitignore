# личное рабочее место аналитика
work/

# локальная конфигурация Claude Code (включённые MCP-серверы)
.claude/settings.local.json

# Промежуточный артефакт установки, а не исходник: setup.sh генерирует его
# заново при каждом запуске (tools/render_configs.py), встраивая внутрь
# АБСОЛЮТНЫЙ путь к репозиторию этой машины и список коннекторов, выбранных
# этим аналитиком. Действующая копия живёт не здесь, а в
# $CODEX_HOME/uzum.config.toml (lib/setup_helpers.py::deploy_codex_profile).
# Пока файл был в git, рабочее дерево у каждого аналитика оставалось
# «грязным» навсегда, и git pull --ff-only на старте сессии обрывался —
# то есть скиллы переставали обновляться вообще.
.codex/config.toml

# сгенерированное
__pycache__/
*.pyc
.pytest_cache/

# секретов здесь быть не должно вообще — они живут в ~/.config/uzum-ai/
*.env
# ...кроме шаблона: в нём только пустые значения и подсказки, где их взять.
!.env.example
*service-account*.json
